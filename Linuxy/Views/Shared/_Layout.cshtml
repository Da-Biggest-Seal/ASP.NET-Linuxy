<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Linuxy</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home")
    {
        @if (ViewData["Title"].ToString() == "Home")
        {
            <link rel="stylesheet" href="~/css/style.css" asp-append-version="true"/>
        }

        @if (ViewData["Title"].ToString() == "Arch")
        {
            <link rel="stylesheet" href="~/css/arch-style.css" asp-append-version="true"/>
        }

        @if (ViewData["Title"].ToString() == "Mint")
        {
            <link rel="stylesheet" href="~/css/mint-style.css" asp-append-version="true"/>
        }

        @if (ViewData["Title"].ToString() == "Hodnocení")
        {
            <link rel="stylesheet" href="~/css/recenze.css" asp-append-version="true"/>
        }
    }
    
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "User")
    {
        <link rel="stylesheet" href="~/css/user-style.css" asp-append-version="true"/>
    }
    
</head>

<header>
    <a href="/Home/Index"><img src="~/obrazky/tux.png" height="85px"></a>

    <div class="nadpis">
        <h1>Linux distribuce</h1>
    
        <nav>
            <a href="/Home/Index">Domů</a>
            <a href="/Home/Arch">Arch Linux</a>
            <a href="/Home/Mint">Linux Mint</a>
            <a href="/Home/Hodnoceni">Recenze</a>
        </nav>
    </div>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

</html>